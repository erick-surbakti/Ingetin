# Bundler
/.bundle
/vendor/bundle

# Environment & secrets
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

# Logs, tmp, storage
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# Test & coverage
/coverage
/spec/examples.txt

# Editor & OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

<% total = summary.received_total + summary.outstanding_total %>
<% percent = total.positive? ? (summary.received_total * 100 / total).round : 0 %>

<% wide = local_assigns[:wide] %>
<div class="<%= wide ? "space-y-3 lg:grid lg:grid-cols-[1.3fr_1fr] lg:gap-3 lg:space-y-0" : "space-y-3" %>">
  <div class="card-hero">
    <div class="pointer-events-none absolute -top-16 -right-10 size-48 rounded-full bg-white/5"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-24 size-56 rounded-full bg-white/5"></div>

    <div class="relative">
      <p class="text-sm font-medium text-white/60">Diterima <%= l(summary_month, format: :month) %></p>
      <p class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl" id="received_total"><%= rupiah(summary.received_total) %></p>

      <div class="mt-5 h-2 overflow-hidden rounded-full bg-white/15" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="Persentase tagihan diterima">
        <div class="h-full rounded-full bg-accent" style="width: <%= percent %>%"></div>
      </div>

      <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-medium text-white/60">Belum diterima</p>
          <p class="mt-0.5 text-lg font-bold" id="outstanding_total"><%= rupiah(summary.outstanding_total) %></p>
        </div>
        <% if local_assigns[:show_link] %>
          <%= link_to invoices_path, class: "btn-light py-2" do %>
            Lihat tagihan <%= icon(:arrow_right, class: "size-4", stroke: 2) %>
          <% end %>
        <% else %>
          <p class="text-xs font-semibold text-white/60"><%= percent %>% terkumpul</p>
        <% end %>
      </div>
    </div>
  </div>

  <dl class="grid grid-cols-3 gap-3 <%= "lg:grid-cols-1 lg:grid-rows-3" if wide %>">
    <div class="stat <%= "lg:flex lg:items-center lg:justify-between lg:py-3" if wide %>">
      <dt class="stat-label flex items-center gap-1.5"><span class="size-2 rounded-full bg-success-600"></span>Lunas</dt>
      <dd class="mt-1.5 <%= "lg:mt-0" if wide %> text-2xl font-extrabold text-ink" id="paid_count"><%= summary.paid.size %></dd>
    </div>
    <div class="stat <%= "lg:flex lg:items-center lg:justify-between lg:py-3" if wide %>">
      <dt class="stat-label flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent"></span>Belum</dt>
      <dd class="mt-1.5 <%= "lg:mt-0" if wide %> text-2xl font-extrabold text-ink" id="unpaid_count"><%= summary.unpaid.size %></dd>
    </div>
    <div class="stat <%= "lg:flex lg:items-center lg:justify-between lg:py-3" if wide %>">
      <dt class="stat-label flex items-center gap-1.5"><span class="size-2 rounded-full bg-danger-700"></span>Telat</dt>
      <dd class="mt-1.5 <%= "lg:mt-0" if wide %> text-2xl font-extrabold text-ink" id="overdue_count"><%= summary.overdue.size %></dd>
    </div>
  </dl>
</div>

<% content_for :title, "Tagihan #{@invoice.tenant.name}" %>
<% tenant = @invoice.tenant %>
<% room = tenant.room %>
<% locked_reason = @invoice.items_locked_reason %>

<%= render "shared/page_header", back_path: invoices_path(month: @invoice.period.strftime("%Y-%m")), back_label: "Tagihan",
      title: "Tagihan #{tenant.name}", subtitle: "#{@invoice.number} · #{l(@invoice.period, format: :month)}" %>

<div class="grid gap-5 lg:grid-cols-5">
  <section class="space-y-4 lg:col-span-3">
    <div class="card">
      <h2 class="section-title">Rincian</h2>
      <ul class="mt-3 divide-y divide-line text-sm" id="invoice_lines">
        <li class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <p class="font-semibold"><%= @invoice.description %></p>
            <p class="text-xs text-muted">Sewa bulanan</p>
          </div>
          <p class="shrink-0 font-bold" id="rent_amount"><%= rupiah(@invoice.rent_amount) %></p>
        </li>
        <% @invoice.items.each do |item| %>
          <li class="flex items-center justify-between gap-3 py-3" id="<%= dom_id(item) %>">
            <div class="min-w-0">
              <p class="font-semibold"><%= item.name %></p>
              <p class="text-xs text-muted">Biaya tambahan</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <p class="font-bold"><%= rupiah(item.amount) %></p>
              <% unless locked_reason %>
                <%= button_to invoice_item_path(@invoice, item), method: :delete, class: "rounded-lg p-1.5 text-muted hover:bg-danger-50 hover:text-danger-700",
                      title: "Hapus #{item.name}", aria: { label: "Hapus #{item.name}" },
                      form: { data: { turbo_confirm: "Hapus #{item.name} dari tagihan?" } } do %>
                  <%= icon(:trash, class: "size-4") %>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
      <div class="mt-2 flex items-center justify-between rounded-xl bg-brand-600 px-4 py-3 text-white">
        <p class="text-sm font-semibold">Total</p>
        <p class="font-extrabold" id="total_amount"><%= rupiah(@invoice.amount) %></p>
      </div>
    </div>

    <% if locked_reason %>
      <div class="flex items-start gap-2.5 rounded-xl border border-line bg-white px-4 py-3 text-sm text-muted shadow-soft" id="items_locked">
        <%= icon(:info, class: "mt-0.5 size-4 shrink-0") %>
        <span>Biaya tambahan tidak bisa diubah. <%= locked_reason %></span>
      </div>
    <% else %>
      <div class="card" id="add_item">
        <h2 class="section-title">Tambah biaya</h2>
        <p class="mt-0.5 text-sm text-muted">Biaya sekali bayar untuk bulan ini, misalnya listrik, air, atau laundry. Total dan link bayar ikut menyesuaikan.</p>

        <%= form_with model: @item, url: invoice_items_path(@invoice), class: "mt-4 space-y-4" do |form| %>
          <%= render "shared/form_errors", record: @item %>

          <div class="grid gap-3 sm:grid-cols-[1fr_12rem]">
            <div>
              <%= form.label :name, "Nama biaya", class: "label" %>
              <%= form.text_field :name, required: true, maxlength: 50, placeholder: "Listrik", list: "item_suggestions", class: "input" %>
              <datalist id="item_suggestions">
                <% %w[ Listrik Air Laundry Wifi Kebersihan Parkir ].each do |suggestion| %>
                  <option value="<%= suggestion %>"></option>
                <% end %>
              </datalist>
            </div>
            <div>
              <%= form.label :amount, "Nominal", class: "label" %>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm font-semibold text-muted">Rp</span>
                <%= form.text_field :amount, required: true, inputmode: "numeric", placeholder: "75000", class: "input pl-11" %>
              </div>
            </div>
          </div>

          <%= form.button type: "submit", class: "btn-primary" do %>
            <%= icon(:plus, class: "size-4", stroke: 2.5) %> Tambah ke tagihan
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>

  <aside class="space-y-4 lg:col-span-2">
    <div class="card">
      <div class="flex items-center gap-3">
        <span class="avatar size-11"><%= initials(tenant.name) %></span>
        <div class="min-w-0 flex-1">
          <%= link_to tenant.name, tenant_path(tenant), class: "block truncate font-bold hover:underline", title: "Riwayat #{tenant.name}" %>
          <p class="truncate text-xs text-muted"><%= room.property.name %> · Kamar <%= room.name %></p>
        </div>
        <%= invoice_status_badge(@invoice) %>
      </div>
      <dl class="mt-4 space-y-2.5 border-t border-line pt-4 text-sm">
        <div class="flex justify-between gap-3"><dt class="text-muted">Jatuh tempo</dt><dd class="text-right font-semibold"><%= l(@invoice.due_on, format: :long) %></dd></div>
        <% if @invoice.paid? %>
          <div class="flex justify-between gap-3"><dt class="text-muted">Dibayar</dt><dd class="text-right font-semibold"><%= l(@invoice.paid_at, format: :long) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">Metode</dt><dd class="text-right font-semibold"><%= paid_via_label(@invoice.paid_via) %></dd></div>
        <% elsif @invoice.sent_count.positive? %>
          <div class="flex justify-between gap-3"><dt class="text-muted">Dikirim</dt><dd class="text-right font-semibold"><%= @invoice.sent_count %>x, terakhir <%= l(@invoice.last_sent_at, format: :short) %></dd></div>
        <% end %>
      </dl>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if @invoice.unpaid? %>
        <%= link_to whatsapp_url_for(@invoice), class: "btn-primary w-full py-3", target: "_blank", rel: "noopener",
              data: { controller: "track-send", track_send_url_value: mark_sent_invoice_path(@invoice), action: "click->track-send#track" } do %>
          <%= icon(:send, class: "size-4", stroke: 2) %> <%= @invoice.overdue? ? "Kirim pengingat WA" : "Kirim tagihan WA" %>
        <% end %>
        <%= button_to mark_paid_invoice_path(@invoice), method: :patch, class: "btn-secondary flex-1",
              form: { class: "contents", data: { turbo_confirm: "Catat tagihan #{tenant.name} lunas dibayar tunai?" } } do %>
          <%= icon(:cash, class: "size-4") %> Catat tunai
        <% end %>
      <% end %>
      <%= link_to public_invoice_path(@invoice.public_token), class: "btn-secondary flex-1", target: "_blank", rel: "noopener" do %>
        <%= icon(:eye, class: "size-4") %> <%= @invoice.paid? ? "Lihat kuitansi" : "Lihat halaman penghuni" %>
      <% end %>
    </div>
  </aside>
</div>

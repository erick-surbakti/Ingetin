<% content_for :title, @property.name %>
<% occupied = @rooms.count { |room| !room.vacant? } %>

<%= link_to properties_path, class: "inline-flex items-center gap-1 text-sm font-semibold text-muted hover:text-ink" do %>
  <%= icon(:chevron_left, class: "size-4", stroke: 2) %> Properti
<% end %>

<div class="card-hero mt-3">
  <div class="pointer-events-none absolute -top-16 -right-10 size-48 rounded-full bg-white/5"></div>
  <div class="relative flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl"><%= @property.name %></h1>
      <% if @property.address.present? %>
        <p class="mt-1 flex items-center gap-1 text-sm text-white/70"><%= icon(:pin, class: "size-4 shrink-0") %><%= @property.address %></p>
      <% end %>
    </div>
    <%= link_to edit_property_path(@property), class: "btn-light py-2" do %>
      <%= icon(:pencil, class: "size-4") %> Ubah
    <% end %>
  </div>
  <dl class="relative mt-6 grid grid-cols-3 gap-3 text-center">
    <div class="rounded-xl bg-white/10 px-2 py-3"><dt class="text-xs text-white/60">Kamar</dt><dd class="mt-0.5 text-xl font-extrabold"><%= @rooms.size %></dd></div>
    <div class="rounded-xl bg-white/10 px-2 py-3"><dt class="text-xs text-white/60">Terisi</dt><dd class="mt-0.5 text-xl font-extrabold"><%= occupied %></dd></div>
    <div class="rounded-xl bg-white/10 px-2 py-3"><dt class="text-xs text-white/60">Kosong</dt><dd class="mt-0.5 text-xl font-extrabold"><%= @rooms.size - occupied %></dd></div>
  </dl>
</div>

<div class="mt-8 flex items-center justify-between gap-3">
  <h2 class="section-title">Kamar (<%= @rooms.size %>)</h2>
  <%= link_to new_property_room_path(@property), class: "btn-primary py-2" do %>
    <%= icon(:plus, class: "size-4", stroke: 2.5) %> Tambah kamar
  <% end %>
</div>

<% if @rooms.empty? %>
  <div class="empty-state mt-4">Belum ada kamar.</div>
<% else %>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <% @rooms.each do |room| %>
      <li class="flex items-center gap-3 rounded-2xl border border-line bg-white p-4 shadow-soft" id="<%= dom_id(room) %>">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-xl <%= room.vacant? ? "bg-canvas text-muted" : "bg-brand-600 text-white" %> text-sm font-extrabold"><%= room.name %></span>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <p class="text-sm font-bold"><%= rupiah(room.monthly_rent) %><span class="font-medium text-muted">/bln</span></p>
          </div>
          <% if room.vacant? %>
            <p class="mt-0.5 text-xs"><span class="badge bg-warning-50 text-warning-700">Kosong</span>
              <%= link_to "Isi penghuni", new_tenant_path(room_id: room.id), class: "link ml-1" %></p>
          <% else %>
            <p class="mt-0.5 flex items-center gap-1.5 truncate text-xs text-muted"><span class="badge bg-success-50 text-success-700">Terisi</span><span class="truncate"><%= room.current_tenant.name %></span></p>
          <% end %>
        </div>
        <%= link_to edit_property_room_path(@property, room), class: "rounded-lg p-2 text-muted hover:bg-canvas hover:text-ink", title: "Ubah kamar #{room.name}", aria: { label: "Ubah kamar #{room.name}" } do %>
          <%= icon(:pencil, class: "size-4") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

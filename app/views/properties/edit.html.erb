<% content_for :title, "Ubah properti" %>

<div class="max-w-2xl">
  <%= render "shared/page_header", back_path: property_path(@property), back_label: @property.name_was, title: "Ubah properti" %>
  <div class="card"><%= render "form", property: @property %></div>

  <%= render layout: "shared/danger_zone", locals: { title: "Hapus properti", description: "Hanya bisa dihapus jika belum ada kamar." } do %>
    <%= button_to "Hapus properti", property_path(@property), method: :delete, class: "btn-danger",
          form: { data: { turbo_confirm: "Hapus #{@property.name}?" } } %>
  <% end %>
</div>

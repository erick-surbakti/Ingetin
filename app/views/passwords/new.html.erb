<% content_for :title, "Lupa kata sandi" %>

<div class="mx-auto max-w-sm pt-8">
  <h1 class="page-title">Lupa kata sandi?</h1>
  <p class="mt-1 text-sm text-stone-600">Masukkan email akunmu. Kami kirimkan link untuk mengatur ulang kata sandi.</p>

  <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>

    <%= form.submit "Kirim link atur ulang", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-center text-sm"><%= link_to "Kembali ke halaman masuk", new_session_path, class: "link" %></p>
</div>

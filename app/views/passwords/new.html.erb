<% content_for :title, "Lupa kata sandi" %>

<%= render layout: "shared/auth_shell" do %>
  <h1 class="page-title">Lupa kata sandi?</h1>
  <p class="mt-1 text-sm text-muted">Masukkan email akunmu. Kami kirimkan link untuk mengatur ulang kata sandi.</p>

  <%= form_with url: passwords_path, class: "mt-7 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>

    <%= form.submit "Kirim link atur ulang", class: "btn-primary w-full py-3.5" %>
  <% end %>

  <p class="mt-8 text-center text-sm"><%= link_to "Kembali ke halaman masuk", new_session_path, class: "link" %></p>
<% end %>

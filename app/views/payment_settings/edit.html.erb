<% content_for :title, "Pembayaran" %>

<div class="max-w-2xl">
  <p class="text-sm font-medium text-muted">Pengaturan</p>
  <h1 class="page-title mt-0.5">Pembayaran online</h1>
  <p class="mt-1 text-sm text-muted">
    Penghuni membayar lewat QRIS atau Virtual Account. Uang masuk langsung ke akun Midtrans milikmu, tidak lewat Ingetin.
  </p>

  <div class="card mt-6 flex items-start gap-3" id="midtrans_status">
    <% if @user.midtrans_connected? %>
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-success-50 text-success-700"><%= icon(:check, stroke: 2.5) %></span>
      <div class="min-w-0">
        <p class="font-bold text-success-700">Midtrans terhubung</p>
        <p class="mt-0.5 text-sm text-muted">Server key: <span class="font-mono"><%= @user.masked_midtrans_server_key %></span></p>
      </div>
    <% else %>
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-warning-50 text-warning-700"><%= icon(:warning) %></span>
      <div class="min-w-0">
        <p class="font-bold text-warning-700">Midtrans belum terhubung</p>
        <p class="mt-0.5 text-sm text-muted">Penghuni belum bisa bayar online sampai server key diisi.</p>
      </div>
    <% end %>
  </div>

  <div class="card mt-4">
    <%= form_with model: @user, url: payment_settings_path, method: :patch, class: "space-y-5" do |form| %>
      <%= render "shared/form_errors", record: @user %>

      <div>
        <%= form.label :midtrans_server_key, "Server key Midtrans", class: "label" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-muted"><%= icon(:key, class: "size-4") %></span>
          <%= form.password_field :midtrans_server_key, value: nil, autocomplete: "off", spellcheck: false,
                placeholder: (@user.midtrans_connected? ? "Kosongkan jika tidak diganti" : "Mid-server-…"), class: "input pl-10 font-mono" %>
        </div>
        <p class="hint">Dashboard Midtrans → Settings → Access Keys. Disimpan terenkripsi.</p>
      </div>

      <div>
        <%= form.label :va_admin_fee, "Biaya admin Virtual Account", class: "label" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm font-semibold text-muted">Rp</span>
          <%= form.text_field :va_admin_fee, inputmode: "numeric", class: "input pl-11" %>
        </div>
        <p class="hint">Ditambahkan ke tagihan jika penghuni memilih VA, untuk menutup biaya VA Midtrans. QRIS tanpa biaya tambahan.</p>
      </div>

      <div class="border-t border-line pt-5">
        <%= form.submit "Simpan", class: "btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="card mt-4 text-sm">
    <div class="flex items-start gap-3">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><%= icon(:info) %></span>
      <div class="min-w-0">
        <p class="font-bold">Atur URL notifikasi di Midtrans</p>
        <p class="mt-0.5 text-muted">
          Dashboard Midtrans → Settings → Payment → Notification URL. Isi dengan URL berikut supaya status lunas tercatat otomatis:
        </p>
      </div>
    </div>
    <p class="mt-3 break-all rounded-xl bg-canvas px-3 py-2.5 font-mono text-xs" id="notification_url"><%= midtrans_webhook_url %></p>
  </div>
</div>

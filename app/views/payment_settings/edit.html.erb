<% content_for :title, "Pembayaran" %>
<% dashboard_url = Midtrans.production? ? "https://dashboard.midtrans.com" : "https://dashboard.sandbox.midtrans.com" %>
<% steps = [ @user.midtrans_connected?, @user.midtrans_connected?, @user.midtrans_notified_at.present?, @user.midtrans_payment_received? ] %>

<div class="max-w-2xl">
  <p class="text-sm font-medium text-muted">Pengaturan</p>
  <h1 class="page-title mt-0.5">Pembayaran online</h1>
  <p class="mt-1 text-sm text-muted">
    Penghuni membayar lewat QRIS atau Virtual Account. Uang masuk langsung ke akun Midtrans milikmu, tidak lewat Ingetin.
  </p>

  <div class="card mt-6 flex items-start gap-3" id="midtrans_status">
    <% if @user.midtrans_connected? %>
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-success-50 text-success-700"><%= icon(:check, stroke: 2.5) %></span>
      <div class="min-w-0 flex-1">
        <p class="font-bold text-success-700">Midtrans terhubung</p>
        <p class="mt-0.5 text-sm text-muted">Server key: <span class="font-mono"><%= @user.masked_midtrans_server_key %></span>
          · <%= @user.midtrans_sandbox_key? ? "mode sandbox (uji coba)" : "mode produksi" %></p>
      </div>
    <% else %>
      <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-warning-50 text-warning-700"><%= icon(:warning) %></span>
      <div class="min-w-0 flex-1">
        <p class="font-bold text-warning-700">Midtrans belum terhubung</p>
        <p class="mt-0.5 text-sm text-muted">Penghuni belum bisa bayar online sampai server key diisi.</p>
      </div>
    <% end %>
    <span class="badge shrink-0 bg-brand-50 text-brand-600" id="steps_done"><%= steps.count(true) %>/<%= steps.size %> langkah</span>
  </div>

  <% unless @user.midtrans_key_matches_environment? %>
    <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-danger-50 bg-danger-50 px-4 py-3 text-sm text-danger-700" id="key_mode_warning" role="alert">
      <%= icon(:warning, class: "mt-0.5 size-4 shrink-0", stroke: 2) %>
      <span>
        <% if @user.midtrans_sandbox_key? %>
          <strong>Server key sandbox</strong> tidak bisa dipakai karena Ingetin berjalan di mode produksi. Ganti dengan server key produksi (tanpa awalan <span class="font-mono">SB-</span>).
        <% else %>
          <strong>Server key produksi</strong> tidak bisa dipakai karena Ingetin berjalan di mode sandbox. Ganti dengan server key sandbox (berawalan <span class="font-mono">SB-</span>).
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="card mt-4" id="panduan">
    <h2 class="section-title">Panduan menghubungkan Midtrans</h2>
    <p class="mt-0.5 text-sm text-muted">Ikuti 4 langkah ini sekali saja. Centang hijau muncul otomatis saat langkah selesai.</p>

    <ol class="mt-6">
      <%= render layout: "payment_settings/step", locals: { number: 1, done: steps[0], title: "Daftar & verifikasi akun Midtrans",
            description: "Daftar sebagai perorangan cukup dengan KTP dan NPWP. Proses verifikasi biasanya 1–3 hari kerja." } do %>
        <%= link_to dashboard_url, class: "btn-secondary py-2", target: "_blank", rel: "noopener" do %>
          Buka dashboard Midtrans <%= icon(:arrow_right, class: "size-4", stroke: 2) %>
        <% end %>
      <% end %>

      <%= render layout: "payment_settings/step", locals: { number: 2, done: steps[1], title: "Simpan server key",
            description: "Di dashboard Midtrans buka Settings → Access Keys, salin Server Key (bukan Client Key), lalu tempel di sini." } do %>
        <%= form_with model: @user, url: payment_settings_path, method: :patch, class: "space-y-5" do |form| %>
          <%= render "shared/form_errors", record: @user %>

          <div>
            <%= form.label :midtrans_server_key, "Server key Midtrans", class: "label" %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-muted"><%= icon(:key, class: "size-4") %></span>
              <%= form.password_field :midtrans_server_key, value: nil, autocomplete: "off", spellcheck: false,
                    placeholder: (@user.midtrans_connected? ? "Kosongkan jika tidak diganti" : "#{"SB-" unless Midtrans.production?}Mid-server-…"), class: "input pl-10 font-mono" %>
            </div>
            <p class="hint">Disimpan terenkripsi. Mode aplikasi saat ini: <strong><%= Midtrans.production? ? "produksi" : "sandbox (uji coba)" %></strong>.</p>
          </div>

          <div>
            <%= form.label :va_admin_fee, "Biaya admin Virtual Account", class: "label" %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm font-semibold text-muted">Rp</span>
              <%= form.text_field :va_admin_fee, inputmode: "numeric", class: "input pl-11" %>
            </div>
            <p class="hint">Ditambahkan ke tagihan jika penghuni memilih VA, untuk menutup biaya VA Midtrans. QRIS tanpa biaya tambahan.</p>
          </div>

          <%= form.submit "Simpan", class: "btn-primary" %>
        <% end %>

        <% if @user.midtrans_connected? %>
          <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-line pt-4">
            <%= button_to check_payment_settings_path, class: "btn-secondary py-2", id: "check_connection" do %>
              <%= icon(:refresh, class: "size-4", stroke: 2) %> Cek koneksi
            <% end %>
            <p class="text-xs text-muted">Memastikan server key diterima Midtrans.</p>
          </div>
        <% end %>
      <% end %>

      <%= render layout: "payment_settings/step", locals: { number: 3, done: steps[2], title: "Pasang URL notifikasi",
            description: "Di dashboard Midtrans buka Settings → Payment → Notification URL, tempel URL ini, lalu simpan. Dengan ini status lunas tercatat otomatis." } do %>
        <div class="flex items-stretch gap-2" data-controller="clipboard">
          <p class="min-w-0 flex-1 break-all rounded-xl bg-canvas px-3 py-2.5 font-mono text-xs" id="notification_url" data-clipboard-target="source"><%= midtrans_webhook_url %></p>
          <button type="button" class="btn-secondary shrink-0 px-3 py-2" data-action="clipboard#copy">
            <%= icon(:document, class: "size-4") %><span data-clipboard-target="label">Salin</span>
          </button>
        </div>
        <p class="hint">
          <% if @user.midtrans_notified_at %>
            Notifikasi pertama diterima <%= l(@user.midtrans_notified_at, format: :long) %>.
          <% else %>
            Centang muncul setelah Midtrans mengirim notifikasi pertama.
          <% end %>
        </p>
      <% end %>

      <%= render layout: "payment_settings/step", locals: { number: 4, done: steps[3], last: true, title: "Coba satu pembayaran",
            description: (Midtrans.production? ? "Bayar satu tagihan kecil sungguhan untuk memastikan uang masuk ke akun Midtrans-mu." : "Buka salah satu tagihan, pilih QRIS atau VA, lalu bayar memakai simulator di dashboard sandbox Midtrans.") } do %>
        <%= link_to invoices_path, class: "btn-secondary py-2" do %>
          Buka daftar tagihan <%= icon(:arrow_right, class: "size-4", stroke: 2) %>
        <% end %>
      <% end %>
    </ol>
  </div>
</div>

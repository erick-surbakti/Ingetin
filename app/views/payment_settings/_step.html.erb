<%# Satu langkah di panduan Midtrans: nomor/centang, judul, keterangan, isi. %>
<li class="relative flex gap-4 pb-8 last:pb-0" id="step_<%= number %>" data-done="<%= done %>">
  <% unless local_assigns[:last] %>
    <span class="absolute top-10 bottom-0 left-[1.1rem] w-px bg-line" aria-hidden="true"></span>
  <% end %>
  <% if done %>
    <span class="relative flex size-9 shrink-0 items-center justify-center rounded-full bg-success-600 text-white" title="Selesai">
      <%= icon(:check, class: "size-5", stroke: 2.5) %><span class="sr-only">Selesai</span>
    </span>
  <% else %>
    <span class="relative flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-brand-200 bg-white text-sm font-extrabold text-brand-600"><%= number %></span>
  <% end %>
  <div class="min-w-0 flex-1 pt-1">
    <p class="font-bold <%= "text-muted line-through decoration-brand-200" if done && local_assigns[:strike] %>"><%= title %></p>
    <p class="mt-0.5 text-sm text-muted"><%= description %></p>
    <div class="mt-3"><%= yield %></div>
  </div>
</li>

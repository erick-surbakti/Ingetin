<%# Kerangka halaman masuk/daftar: panel gelap di kiri (laptop), form di kanan. %>
<div class="lg:grid lg:min-h-[calc(100vh-3rem)] lg:grid-cols-2 lg:gap-10">
  <aside class="relative hidden overflow-hidden rounded-3xl bg-brand-600 p-10 text-white lg:flex lg:flex-col">
    <div class="pointer-events-none absolute -top-24 -right-24 size-80 rounded-full bg-white/5"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-20 size-96 rounded-full bg-white/5"></div>

    <div class="relative">
      <%= render "shared/logo", size: :lg, tone: :light %>
    </div>

    <div class="relative mt-auto">
      <p class="text-4xl leading-tight font-extrabold tracking-tight">Tagihan kos<br>beres sendiri.</p>
      <p class="mt-3 max-w-sm text-white/70">Tagihan dibuat otomatis, penghuni bayar lewat QRIS, status lunas tercatat tanpa dicek manual.</p>

      <ul class="mt-8 space-y-3 text-sm font-semibold">
        <% [ [ :calendar, "Tagihan otomatis H-3 jatuh tempo" ], [ :qr, "Bayar QRIS & Virtual Account" ], [ :send, "Kirim tagihan ke WhatsApp sekali tap" ] ].each do |name, text| %>
          <li class="flex items-center gap-3">
            <span class="flex size-9 items-center justify-center rounded-xl bg-white/10"><%= icon(name, class: "size-5") %></span>
            <%= text %>
          </li>
        <% end %>
      </ul>
    </div>
  </aside>

  <div class="flex flex-col justify-center py-6 lg:py-10">
    <div class="mx-auto w-full max-w-sm">
      <div class="mb-8 lg:hidden">
        <%= render "shared/logo", size: :md %>
      </div>
      <%= yield %>
    </div>
  </div>
</div>

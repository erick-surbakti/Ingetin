<% if record.errors.any? %>
  <div id="form_errors" role="alert" class="flex items-start gap-2.5 rounded-xl border border-danger-50 bg-danger-50 px-4 py-3 text-sm text-danger-700">
    <%= icon(:warning, class: "mt-0.5 size-4 shrink-0", stroke: 2) %>
    <div>
      <p class="font-bold">Periksa lagi isian berikut:</p>
      <ul class="mt-1 list-disc pl-5">
        <% record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

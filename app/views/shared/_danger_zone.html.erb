<%# Kartu aksi berbahaya (hapus / tandai keluar) di bawah form. %>
<div class="mt-6 rounded-2xl border border-danger-50 bg-white p-4 shadow-soft sm:p-5">
  <div class="flex items-start gap-3">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-danger-50 text-danger-700"><%= icon(:warning) %></span>
    <div class="min-w-0 flex-1">
      <p class="font-bold"><%= title %></p>
      <p class="mt-0.5 text-sm text-muted"><%= description %></p>
      <div class="mt-3"><%= yield %></div>
    </div>
  </div>
</div>

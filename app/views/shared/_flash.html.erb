<% if notice.present? %>
  <div id="notice" role="status" class="no-print mb-5 flex items-start gap-2.5 rounded-xl border border-success-50 bg-success-50 px-4 py-3 text-sm font-semibold text-success-700">
    <%= icon(:check, class: "mt-0.5 size-4 shrink-0", stroke: 2.5) %>
    <span><%= notice %></span>
  </div>
<% end %>
<% if alert.present? %>
  <div id="alert" role="alert" class="no-print mb-5 flex items-start gap-2.5 rounded-xl border border-danger-50 bg-danger-50 px-4 py-3 text-sm font-semibold text-danger-700">
    <%= icon(:warning, class: "mt-0.5 size-4 shrink-0", stroke: 2) %>
    <span><%= alert %></span>
  </div>
<% end %>

<% if notice.present? %>
  <div id="notice" role="status" class="mb-4 rounded-lg border border-brand-100 bg-brand-50 px-3 py-2 text-sm font-medium text-brand-900"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div id="alert" role="alert" class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-800"><%= alert %></div>
<% end %>

<% content_for :title, @invoice.paid? ? "Kuitansi" : "Tagihan" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<% tenant = @invoice.tenant %>
<% property = tenant.room.property %>

<div class="mx-auto max-w-md pb-6">
  <div class="no-print mb-5 flex items-center justify-center gap-2 text-sm font-bold text-muted">
    <span class="flex size-7 items-center justify-center rounded-lg bg-brand-600 text-white"><%= icon(:home, class: "size-4") %></span>
    Ingetin
  </div>

  <% if @invoice.paid? %>
    <%# Kuitansi (gaya struk pembayaran) %>
    <div class="card px-5 pt-7 pb-6 text-center">
      <h1 class="text-xs font-bold tracking-widest text-muted uppercase">Kuitansi pembayaran</h1>
      <span class="mx-auto mt-4 flex size-14 items-center justify-center rounded-full bg-success-600 text-white ring-8 ring-success-50">
        <%= icon(:check, class: "size-7", stroke: 2.5) %>
      </span>
      <p class="mt-4 text-sm font-bold text-success-700">Pembayaran berhasil</p>
      <p class="mt-1 text-3xl font-extrabold tracking-tight" id="amount"><%= rupiah(@invoice.amount) %></p>

      <div class="mt-6 rounded-2xl border border-line p-4 text-left">
        <div class="flex items-center gap-3">
          <span class="avatar bg-brand-600 text-white"><%= initials(property.name) %></span>
          <div class="min-w-0">
            <p class="truncate font-bold"><%= property.name %></p>
            <p class="truncate text-xs text-muted">Pemilik: <%= property.user.name %></p>
          </div>
        </div>
        <dl class="mt-4 space-y-2 border-t border-dashed border-line pt-4 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-muted">Penghuni</dt><dd class="text-right font-semibold"><%= tenant.name %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">Kamar</dt><dd class="text-right font-semibold"><%= tenant.room.name %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">Keterangan</dt><dd class="text-right font-semibold"><%= @invoice.description %></dd></div>
          <% if @invoice.items.any? %>
            <div class="flex justify-between gap-3"><dt class="text-muted">Sewa</dt><dd class="text-right font-semibold"><%= rupiah(@invoice.rent_amount) %></dd></div>
            <% @invoice.items.each do |item| %>
              <div class="flex justify-between gap-3"><dt class="text-muted"><%= item.name %></dt><dd class="text-right font-semibold"><%= rupiah(item.amount) %></dd></div>
            <% end %>
          <% end %>
        </dl>
      </div>

      <div class="mt-5 text-left">
        <p class="section-title">Detail transaksi</p>
        <dl class="mt-3 space-y-2.5 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-muted">No. tagihan</dt><dd class="text-right font-semibold"><%= @invoice.number %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">Metode</dt><dd class="text-right font-semibold"><%= paid_via_label(@invoice.paid_via) %></dd></div>
          <div class="flex items-center justify-between gap-3"><dt class="text-muted">Status</dt><dd><%= invoice_status_badge(@invoice) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">Tanggal</dt><dd class="text-right font-semibold" id="paid_at"><%= l(@invoice.paid_at.to_date, format: :long) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-muted">Waktu</dt><dd class="text-right font-semibold"><%= l(@invoice.paid_at, format: "%H:%M WIB") %></dd></div>
          <div class="flex justify-between gap-3 border-t border-line pt-3 text-base"><dt class="font-bold">Total pembayaran</dt><dd class="text-right font-extrabold"><%= rupiah(@invoice.amount) %></dd></div>
        </dl>
      </div>
    </div>

    <div class="no-print mt-4" data-controller="print">
      <button type="button" class="btn-primary w-full py-3.5" data-action="print#print">
        <%= icon(:printer, class: "size-5") %> Simpan / cetak kuitansi
      </button>
      <p class="mt-3 text-center text-xs text-muted">Simpan halaman ini sebagai bukti pembayaran.</p>
    </div>
  <% else %>
    <%# Tagihan yang belum dibayar %>
    <div class="card overflow-hidden p-0 sm:p-0">
      <div class="bg-brand-50 px-5 pt-5 pb-16">
        <p class="text-sm font-semibold text-muted"><%= property.name %></p>
        <h1 class="mt-1 text-2xl font-extrabold tracking-tight">Tagihan sewa</h1>
        <div class="mt-2 flex items-center gap-2 text-sm text-muted">
          <span><%= @invoice.number %></span>
          <%= invoice_status_badge(@invoice) %>
        </div>
      </div>

      <div class="relative mx-4 -mt-11 rounded-2xl border border-line bg-white p-4 shadow-soft">
        <p class="text-xs font-semibold text-muted">Jumlah tagihan</p>
        <p class="mt-1 text-3xl font-extrabold tracking-tight text-brand-600" id="amount"><%= rupiah(@invoice.amount) %></p>
        <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-line pt-4 text-sm">
          <div><dt class="text-xs text-muted">Diterbitkan</dt><dd class="mt-0.5 font-semibold"><%= l(@invoice.created_at.to_date, format: :long) %></dd></div>
          <div><dt class="text-xs text-muted">Jatuh tempo</dt><dd class="mt-0.5 font-semibold <%= "text-danger-700" if @invoice.overdue? %>"><%= l(@invoice.due_on, format: :long) %></dd></div>
        </dl>
        <div class="mt-4 border-t border-line pt-4">
          <p class="text-xs text-muted">Tagihan untuk</p>
          <div class="mt-2 flex items-center gap-3">
            <span class="avatar size-9"><%= initials(tenant.name) %></span>
            <div class="min-w-0">
              <p class="truncate text-sm font-bold"><%= tenant.name %></p>
              <p class="truncate text-xs text-muted">Kamar <%= tenant.room.name %> · pemilik <%= property.user.name %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="px-5 pt-5 pb-5">
        <p class="text-xs font-semibold text-muted">Rincian</p>
        <ul class="mt-2 divide-y divide-line rounded-xl bg-canvas px-3 text-sm">
          <li class="flex items-start justify-between gap-3 py-3">
            <p class="font-semibold"><%= @invoice.description %></p>
            <p class="shrink-0 font-bold"><%= rupiah(@invoice.rent_amount) %></p>
          </li>
          <% @invoice.items.each do |item| %>
            <li class="flex items-start justify-between gap-3 py-3">
              <p class="font-semibold"><%= item.name %></p>
              <p class="shrink-0 font-bold"><%= rupiah(item.amount) %></p>
            </li>
          <% end %>
        </ul>
        <div class="mt-3 flex items-center justify-between rounded-xl bg-brand-600 px-4 py-3 text-white">
          <p class="text-sm font-semibold">Total</p>
          <p class="font-extrabold"><%= rupiah(@invoice.amount) %></p>
        </div>
      </div>
    </div>

    <% if @processing %>
      <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-warning-50 bg-warning-50 px-4 py-3 text-sm font-semibold text-warning-700" id="processing">
        <%= icon(:info, class: "mt-0.5 size-4 shrink-0", stroke: 2) %>
        <span>Pembayaran sedang diproses. Muat ulang halaman ini dalam beberapa saat.</span>
      </div>
    <% end %>

    <% if property.user.midtrans_connected? %>
      <div class="mt-5 space-y-3" id="payment_options"
           data-controller="pay" data-pay-url-value="<%= public_invoice_payments_path(@invoice.public_token) %>">
        <p class="section-title">Pilih cara bayar</p>
        <button type="button" class="btn-primary w-full justify-between px-4 py-3.5" id="pay_qris"
                data-pay-target="button" data-action="pay#start" data-pay-channel-param="qris">
          <span class="flex items-center gap-2.5"><%= icon(:qr) %> Bayar dengan QRIS</span>
          <span><%= rupiah(@invoice.amount) %></span>
        </button>
        <button type="button" class="btn-secondary w-full justify-between px-4 py-3.5" id="pay_va"
                data-pay-target="button" data-action="pay#start" data-pay-channel-param="va">
          <span class="flex items-center gap-2.5"><%= icon(:bank) %> Virtual Account</span>
          <span><%= rupiah(@invoice.amount + property.user.va_admin_fee) %></span>
        </button>
        <% if property.user.va_admin_fee.positive? %>
          <p class="text-center text-xs text-muted">Virtual Account termasuk biaya admin <%= rupiah(property.user.va_admin_fee) %>.</p>
        <% end %>
        <p class="hidden rounded-xl bg-danger-50 px-3 py-2 text-center text-sm font-semibold text-danger-700" data-pay-target="error" role="alert"></p>
      </div>
    <% else %>
      <div class="empty-state mt-5" id="payment_unavailable">
        <span class="mb-2 flex size-10 items-center justify-center rounded-full bg-warning-50 text-warning-700"><%= icon(:info) %></span>
        Pembayaran online belum tersedia. Hubungi pemilik kos.
      </div>
    <% end %>
  <% end %>
</div>

<% content_for :title, "Masuk" %>

<%= render layout: "shared/auth_shell" do %>
  <h1 class="page-title">Selamat datang kembali</h1>
  <p class="mt-1 text-sm text-muted">Masuk untuk mengelola tagihan kos.</p>

  <%= form_with url: session_url, class: "mt-7 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>

    <div>
      <div class="flex items-center justify-between">
        <%= form.label :password, "Kata sandi", class: "label" %>
        <%= link_to "Lupa kata sandi?", new_password_path, class: "mb-1.5 text-xs font-semibold text-muted hover:text-ink" %>
      </div>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Masuk", class: "btn-primary w-full py-3.5" %>
  <% end %>

  <p class="mt-8 text-center text-sm text-muted">Belum punya akun? <%= link_to "Daftar gratis", new_registration_path, class: "link" %></p>
<% end %>

<% content_for :title, "Daftar" %>

<%= render layout: "shared/auth_shell" do %>
  <h1 class="page-title">Daftar akun pemilik kos</h1>
  <p class="mt-1 text-sm text-muted">Gratis untuk maksimal 10 kamar.</p>

  <%= form_with model: @user, url: registration_path, class: "mt-7 space-y-5" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= form.label :name, "Nama", class: "label" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 100, class: "input" %>
    </div>

    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
    </div>

    <div>
      <%= form.label :password, "Kata sandi", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
      <p class="hint">Minimal 8 karakter.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Ulangi kata sandi", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Daftar", class: "btn-primary w-full py-3.5" %>
  <% end %>

  <p class="mt-8 text-center text-sm text-muted">Sudah punya akun? <%= link_to "Masuk", new_session_path, class: "link" %></p>
<% end %>

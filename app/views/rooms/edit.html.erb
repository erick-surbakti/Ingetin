<% content_for :title, "Ubah kamar" %>

<div class="max-w-2xl">
  <%= render "shared/page_header", back_path: property_path(@property), back_label: @property.name, title: "Ubah kamar #{@room.name}", subtitle: @property.name %>
  <div class="card"><%= render "form", property: @property, room: @room %></div>

  <%= render layout: "shared/danger_zone", locals: { title: "Hapus kamar", description: "Hanya bisa dihapus jika kamar belum pernah punya penghuni." } do %>
    <%= button_to "Hapus kamar", property_room_path(@property, @room), method: :delete, class: "btn-danger",
          form: { data: { turbo_confirm: "Hapus kamar #{@room.name}?" } } %>
  <% end %>
</div>

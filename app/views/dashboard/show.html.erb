<% content_for :title, "Dasbor" %>

<h1 class="page-title">Halo, <%= Current.user.name %></h1>
<p class="mt-1 text-sm text-stone-600">Ringkasan tagihan <%= l(@month, format: :month) %>.</p>

<% if @property_count.zero? %>
  <div class="card mt-6 text-center">
    <p class="font-semibold">Belum ada properti</p>
    <p class="mt-1 text-sm text-stone-600">Tambahkan rumah kos dan kamar untuk mulai membuat tagihan.</p>
    <%= link_to "Tambah properti", new_property_path, class: "btn-primary mt-4" %>
  </div>
<% else %>
  <div class="mt-6">
    <%= render "invoices/summary", summary: @summary %>
  </div>

  <div class="mt-8 flex items-center justify-between">
    <h2 class="text-lg font-semibold">Belum bayar</h2>
    <%= link_to "Semua tagihan", invoices_path, class: "link text-sm" %>
  </div>

  <% unpaid = @summary.sorted.select(&:unpaid?) %>
  <% if unpaid.empty? %>
    <div class="card mt-3 text-center text-sm text-stone-600" id="all_paid">
      <%= @summary.invoices.empty? ? "Belum ada tagihan bulan ini." : "Semua tagihan bulan ini sudah lunas." %>
    </div>
  <% else %>
    <ul class="mt-3 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white" id="unpaid_invoices">
      <% unpaid.each do |invoice| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3" id="<%= dom_id(invoice) %>">
          <div class="min-w-0">
            <p class="truncate font-medium"><%= invoice.tenant.name %></p>
            <p class="text-sm text-stone-600"><%= invoice.tenant.room.name %> · <%= rupiah(invoice.amount) %> · <%= l(invoice.due_on, format: :short) %></p>
          </div>
          <%= invoice_status_badge(invoice) %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% content_for :title, @tenant.name %>
<% room = @tenant.room %>

<%= link_to tenants_path(status: (@tenant.active? ? nil : "moved_out")), class: "inline-flex items-center gap-1 text-sm font-semibold text-muted hover:text-ink" do %>
  <%= icon(:chevron_left, class: "size-4", stroke: 2) %> Penghuni
<% end %>

<div class="card-hero mt-3">
  <div class="pointer-events-none absolute -top-16 -right-10 size-48 rounded-full bg-white/5"></div>
  <div class="relative flex flex-wrap items-start justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <span class="avatar size-14 bg-white/10 text-lg text-white"><%= initials(@tenant.name) %></span>
      <div class="min-w-0">
        <h1 class="truncate text-2xl font-extrabold tracking-tight sm:text-3xl"><%= @tenant.name %></h1>
        <p class="mt-0.5 text-sm text-white/70"><%= room.property.name %> · Kamar <%= room.name %></p>
      </div>
    </div>
    <%= link_to edit_tenant_path(@tenant), class: "btn-light py-2" do %>
      <%= icon(:pencil, class: "size-4") %> Ubah data
    <% end %>
  </div>

  <dl class="relative mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-4">
    <div><dt class="text-xs text-white/60">WhatsApp</dt><dd class="mt-0.5 font-semibold"><%= link_to phone_display(@tenant.phone), "https://wa.me/#{@tenant.phone}", target: "_blank", rel: "noopener", class: "underline decoration-white/30 underline-offset-4 hover:decoration-white" %></dd></div>
    <div><dt class="text-xs text-white/60">Masuk</dt><dd class="mt-0.5 font-semibold"><%= l(@tenant.move_in_on, format: :long) %></dd></div>
    <div><dt class="text-xs text-white/60">Jatuh tempo</dt><dd class="mt-0.5 font-semibold">Tanggal <%= @tenant.due_day %></dd></div>
    <div><dt class="text-xs text-white/60">Status</dt><dd class="mt-0.5 font-semibold"><%= @tenant.active? ? "Aktif" : "Keluar #{l(@tenant.moved_out_on, format: :long)}" %></dd></div>
  </dl>
</div>

<dl class="mt-4 grid grid-cols-3 gap-3">
  <div class="stat">
    <dt class="stat-label">Sudah dibayar</dt>
    <dd class="mt-1.5 truncate text-lg font-extrabold sm:text-2xl" id="paid_total"><%= rupiah(@paid_total) %></dd>
  </div>
  <div class="stat">
    <dt class="stat-label">Tagihan</dt>
    <dd class="mt-1.5 text-lg font-extrabold sm:text-2xl" id="invoice_count"><%= @invoices.size %></dd>
  </div>
  <div class="stat">
    <dt class="stat-label">Pernah telat</dt>
    <dd class="mt-1.5 text-lg font-extrabold sm:text-2xl <%= "text-danger-700" if @late_count.positive? %>" id="late_count"><%= @late_count %>x</dd>
  </div>
</dl>

<h2 class="section-title mt-8">Riwayat tagihan</h2>

<% if @invoices.empty? %>
  <div class="empty-state mt-3">
    <span class="mb-2 flex size-10 items-center justify-center rounded-full bg-brand-50 text-brand-600"><%= icon(:calendar) %></span>
    Belum ada tagihan. Tagihan dibuat otomatis <%= InvoiceGenerator::LEAD_DAYS %> hari sebelum jatuh tempo.
  </div>
<% else %>
  <ul class="list-card mt-3" id="invoice_history">
    <% @invoices.each do |invoice| %>
      <li id="<%= dom_id(invoice, :history) %>">
        <%= link_to invoice_path(invoice), class: "flex items-center gap-3 px-4 py-3.5 hover:bg-canvas sm:px-5" do %>
          <span class="flex size-11 shrink-0 flex-col items-center justify-center rounded-xl bg-canvas text-center leading-tight">
            <span class="text-[11px] font-semibold text-muted"><%= l(invoice.period, format: "%b") %></span>
            <span class="text-xs font-extrabold"><%= invoice.period.year %></span>
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-bold"><%= l(invoice.period, format: :month) %></p>
            <p class="truncate text-xs text-muted">
              <% if invoice.paid? %>
                Lunas <%= l(invoice.paid_at, format: :short) %> · <%= paid_via_label(invoice.paid_via) %>
                <% if invoice.paid_at.to_date > invoice.due_on %>· <span class="text-danger-700">telat</span><% end %>
              <% else %>
                Jatuh tempo <%= l(invoice.due_on, format: :long) %>
              <% end %>
              <% if invoice.items.any? %>· +<%= invoice.items.size %> biaya<% end %>
            </p>
          </div>
          <div class="flex shrink-0 flex-col items-end gap-1">
            <p class="text-sm font-bold"><%= rupiah(invoice.amount) %></p>
            <%= invoice_status_badge(invoice) %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

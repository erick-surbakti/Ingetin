# Salin ke .env untuk development. Jangan commit .env.

# Host publik aplikasi (dipakai untuk link bayar, kuitansi, dan URL webhook)
APP_HOST=localhost:3000
APP_PROTOCOL=http

# Zona waktu bisnis (jadwal tagihan H-3 dihitung di zona ini)
TZ=Asia/Jakarta

# Midtrans: sandbox | production
# Server key & client key TIDAK di sini: tiap pemilik kos menyimpan miliknya
# sendiri, terenkripsi di database.
MIDTRANS_ENV=sandbox

# SMTP untuk email login & reset password
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

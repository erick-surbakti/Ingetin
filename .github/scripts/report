#!/usr/bin/env bash
# Jalankan perintah; jika gagal, tampilkan ekor output sebagai annotation
# supaya error terbaca dari ringkasan run tanpa membuka log lengkap.
# Pemakaian: .github/scripts/report "Judul" perintah arg...
set -uo pipefail

title="$1"
shift

out="$(mktemp)"
"$@" 2>&1 | tee "$out"
code=${PIPESTATUS[0]}

if [ "$code" -ne 0 ]; then
  # Hapus kode warna ANSI lalu encode newline untuk format workflow command.
  msg="$(tail -c 3800 "$out" \
    | sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g' \
    | sed ':a;N;$!ba;s/%/%25/g;s/\r/%0D/g;s/\n/%0A/g')"
  echo "::error title=${title} gagal::${msg}"
fi

rm -f "$out"
exit "$code"
